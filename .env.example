# Local backend, worker, and `npm run dev` configuration.
# Node processes use inherited environment variables; this file is a template,
# not an automatically loaded dotenv file.

# HTTP / frontend development
PORT=3000
FRONTEND_PORT=5173
VITE_BACKEND_URL=http://127.0.0.1:3000

# Durable backend and backtest-worker runtime
DATABASE_URL=postgres://cryptox:cryptox@localhost:5432/cryptox
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
BACKTEST_WORKER_CONCURRENCY=1
BACKTEST_RECOVERY_INTERVAL_MS=1000

# Market Data uses Binance public REST and WebSocket endpoints; no API key is needed.
MARKET_DATA_PROVIDER=BINANCE
MARKET_DATA_BINANCE_REST_URL=https://api.binance.com
MARKET_DATA_BINANCE_WS_URL=wss://stream.binance.com:9443

# Local News and Sentiment defaults do not require external credentials.
NEWS_PROVIDER=LOCAL_DEMO

# Future live-news provider configuration. RSS needs only feed URLs; an
# aggregated News API also needs its provider-issued key. These are unused
# while NEWS_PROVIDER=LOCAL_DEMO.
# NEWS_RSS_FEED_URLS=https://example.com/crypto.rss,https://example.org/news.xml
# NEWS_API_BASE_URL=https://newsapi.example/v1
# NEWS_API_KEY=
# NEWS_CRAWLER_SOURCE_URLS=https://example.com/crypto,https://example.org/markets

# Optional OpenAI-backed LLM interpretation for configured crawler sources.
# OPENAI_API_KEY=
# NEWS_CRAWLER_MODEL_NAME=gpt-4o-mini

# Optional OpenAI-backed strategy generation. Leave OPENAI_API_KEY unset to
# keep strategy generation unavailable while manual strategy creation works.
# OPENAI_API_KEY=
STRATEGY_MODEL_NAME=gpt-4o-mini
# STRATEGY_MODEL_VERSION=
STRATEGY_PROMPT_VERSION=1

# Bounded public URL import limits for strategy generation.
STRATEGY_URL_TIMEOUT_MS=5000
STRATEGY_URL_MAX_REDIRECTS=3
STRATEGY_URL_MAX_RESPONSE_BYTES=1000000
STRATEGY_URL_MAX_TEXT_CHARACTERS=100000

# Demo market seeding is intentionally opt-in. Enable only with the Compose
# demo profile, alongside MARKET_DATA_PROVIDER=DEMO.
# MARKET_DATA_SEED_MODE=DEMO
