# Local backend, worker, and Compose configuration template.
# This file is documentation only; it is not loaded automatically.
# Keep real credentials in an ignored .env or in the deployment secret store.

# Runtime profiles: DEVELOPMENT and PRODUCTION require PostgreSQL, Redis,
# JWT_SECRET, and the configured strategy model. TEST/DEMO are explicit
# non-durable compositions for tests and offline presentation.
RUNTIME_PROFILE=DEVELOPMENT

# HTTP / frontend development
PORT=3000
FRONTEND_PORT=5173
VITE_BACKEND_URL=http://127.0.0.1:3000

# Durable backend and backtest-worker runtime
DATABASE_URL=postgres://cryptox:cryptox@localhost:5432/cryptox
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
BACKTEST_WORKER_CONCURRENCY=1
BACKTEST_RECOVERY_INTERVAL_MS=30000

# Market Data uses Binance public REST and WebSocket endpoints; no API key is needed.
MARKET_DATA_PROVIDER=BINANCE
MARKET_DATA_BINANCE_REST_URL=https://api.binance.com
MARKET_DATA_BINANCE_WS_URL=wss://stream.binance.com:9443

# News uses CoinDesk's official RSS feed by default.
NEWS_PROVIDER=COINDESK_RSS

# Optional semantic HTML crawler. Set NEWS_PROVIDER=CRAWLER_LLM and provide
# every value below; startup rejects an incomplete crawler configuration.
# CRAWLER_SOURCE_URLS=https://news.example.com/crypto
# CRAWLER_MODEL_ENDPOINT=http://127.0.0.1:8080/v1/chat/completions
# CRAWLER_MODEL_NAME=local-news-model
# CRAWLER_LLM_API_KEY=local-test-key
CRAWLER_PROMPT_VERSION=1
CRAWLER_REQUEST_TIMEOUT_MS=10000
CRAWLER_MAX_HTML_BYTES=1000000
CRAWLER_MAX_INTERPRETER_HTML_BYTES=64000
CRAWLER_MAX_OUTPUT_BYTES=256000
CRAWLER_MAX_CANDIDATES=8
CRAWLER_MAX_FIELD_LENGTH=50000

# 1. Strategy Generation (Deep reasoning & mathematical parameter constraints)
STRATEGY_MODEL_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
STRATEGY_MODEL_NAME=gemini-2.5-pro
STRATEGY_LLM_API_KEY=replace-with-private-model-api-key
# STRATEGY_MODEL_VERSION=
STRATEGY_PROMPT_VERSION=1
STRATEGY_MODEL_TIMEOUT_MS=20000

# 2. News Sentiment Analysis (High-frequency, lightweight)
SENTIMENT_MODEL_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
SENTIMENT_MODEL_NAME=gemini-2.0-flash-lite
SENTIMENT_LLM_API_KEY=replace-with-private-model-api-key
SENTIMENT_MODEL_TIMEOUT_MS=15000

# 3. HTML Website News Crawler (Large context window)
# CRAWLER_MODEL_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# CRAWLER_MODEL_NAME=gemini-2.5-flash
# CRAWLER_LLM_API_KEY=replace-with-private-model-api-key

# 4. Self-Healing Extraction Template Engine (DOM & CSS selector synthesis)
# TEMPLATE_MODEL_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# TEMPLATE_MODEL_NAME=gemini-1.5-flash
# TEMPLATE_LLM_API_KEY=replace-with-private-model-api-key

# Bounded public URL import limits for strategy generation.
STRATEGY_URL_TIMEOUT_MS=5000
STRATEGY_URL_MAX_REDIRECTS=3
STRATEGY_URL_MAX_RESPONSE_BYTES=1000000
STRATEGY_URL_MAX_TEXT_CHARACTERS=100000

# Backtest form defaults are runtime configuration exposed through capabilities.
BACKTEST_DEFAULT_INITIAL_CAPITAL=1000
BACKTEST_DEFAULT_FEE_RATE_PERCENT=0
BACKTEST_DEFAULT_SLIPPAGE_BPS=5
BACKTEST_DEFAULT_MAX_ATTEMPTS=1

# Demo market seeding is opt-in and profile-gated.
# RUNTIME_PROFILE=DEMO
# MARKET_DATA_PROVIDER=DEMO
# MARKET_DATA_SEED_MODE=DEMO
