# Copy this file to the ignored repository-root .env and edit it locally.
# The root .env is user-created local configuration; never commit it or paste
# credential values into tracked files.

# Server-only runtime configuration. These names are intentionally not VITE_*
# and are never passed to the frontend image or browser bundle.
NODE_ENV=development
PORT=3000
AUTH_COOKIE_SECURE=false
DATABASE_URL=
GIT_COMMIT=
BACKTEST_MAX_IN_FLIGHT=2
LEADERBOARD_SCOPE_ID=

# Binance provider overrides. The provider has these public defaults when the
# overrides are empty, so local credentials are not needed for market data.
BINANCE_API_BASE_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# Existing CoinDesk JSON provider configuration. The API key is optional for
# the RSS path below and must be supplied only in this ignored local file when
# the legacy JSON adapter is intentionally selected.
COINDESK_API_KEY=
COINDESK_BASE_URL=

# Provider-neutral configured RSS source. The URL and at least one matching
# HTTPS allowlist entry are required; no CoinDesk API key is needed for RSS.
COINDESK_RSS_URL=https://www.coindesk.com/arc/outboundfeeds/rss/?output=1
COINDESK_RSS_ALLOWED_HOSTS=www.coindesk.com
COINDESK_RSS_ALLOWED_URL_PREFIXES=https://www.coindesk.com/arc/outboundfeeds/rss/
COINDESK_RSS_ALLOWED_URLS=
NEWS_REFRESH_INTERVAL_MINUTES=5

# Controlled LLM_AUTHORING_V1 configuration. For Gemini compatibility, put
# Google's OpenAI-compatible endpoint in LLM_AUTHORING_ENDPOINT, its model in
# LLM_AUTHORING_MODEL, and the local credential in LLM_AUTHORING_API_KEY.
# There is no GEMINI_* repository alias. Do not place a real key here.
LLM_AUTHORING_ENDPOINT=
LLM_AUTHORING_MODEL=
LLM_AUTHORING_API_KEY=

# Public frontend configuration only. Vite loads only VITE_* names from this
# root file. These local defaults use the backend's same-origin REST proxy and
# the host-mapped backend WebSocket.
VITE_MARKET_SOURCE=remote
VITE_MARKET_REST_URL=/api
VITE_MARKET_WS_URL=ws://localhost:3000
VITE_AUTH_SOURCE=remote
VITE_AUTH_BASE_URL=/api
VITE_FEATURE_SOURCE=remote
VITE_FEATURE_BASE_URL=/api
VITE_AUTH_PROXY_TARGET=http://localhost:3000
VITE_BACKEND_URL=http://localhost:3000

# CRYPTOX_LOCAL_POSTGRES_PASSWORD is generated in the ignored
# infra/db/local.env by npm run db:local:prepare; it does not belong in this
# example file. Docker Compose uses that generated value internally for its
# postgres-dev DATABASE_URL.
