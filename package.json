{
  "name": "cryptox",
  "private": true,
  "workspaces": [
    "modules/*",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:backend": "npm run build --workspace=@cryptox/backend",
    "dev": "node scripts/dev.mjs",
    "dev:backend": "npm run build:backend && npm run start:backend",
    "dev:frontend": "npm run dev --workspace=@cryptox/frontend",
    "docker:smoke": "node scripts/docker-smoke.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "smoke:backend": "npm run build:backend && node scripts/smoke-backend.mjs",
    "smoke:dev": "node scripts/smoke-dev.mjs",
    "start": "npm run start:backend",
    "start:backend": "node scripts/start-backend.mjs",
    "start:worker": "npm run start --workspace=@cryptox/backtest-worker",
    "test": "npm run test:seed:dev && npm run test --workspaces --if-present",
    "test:workflow": "node --test scripts/start-backend.test.mjs",
    "arch:check": "dependency-cruise --config .dependency-cruiser.js --exclude dist --exclude d.ts modules apps packages",
    "check:generated": "node scripts/check-generated-artifacts.mjs",
    "db:migrate": "node-pg-migrate up -m infra/db/migrations",
    "seed:dev": "node scripts/seed-dev-market.mjs",
    "test:seed:dev": "npm run build --workspace=@cryptox/market-data && node --test scripts/seed-dev-market.test.mjs"
  },
  "overrides": {
    "@nestjs/common": {
      "file-type": "21.3.4"
    },
    "@nestjs/platform-express": {
      "body-parser": "1.20.6",
      "multer": "2.3.0"
    },
    "node-pg-migrate": {
      "glob": "11.1.0"
    },
    "qs": "6.16.0",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.3.1",
    "@types/node": "^22.10.2",
    "dependency-cruiser": "^16.10.4",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.23.0",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
