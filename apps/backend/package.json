{
  "name": "@cryptox/backend",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/apps/backend/src/main.js",
    "dev": "ts-node src/main.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.auth-e2e.json --noEmit",
    "typecheck:auth-e2e": "tsc -p tsconfig.auth-e2e.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.auth-e2e.json --noEmit"
  },
  "dependencies": {
    "@cryptox/auth": "*",
    "@cryptox/contracts": "*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  }
}
