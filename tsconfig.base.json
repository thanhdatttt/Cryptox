{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "modules/*": ["modules/*"],
      "@cryptox/contracts/*": ["packages/contracts/*"]
    }
  }
}
